# 配置优先级：环境变量 > .env > pyproject.toml 的 [tool.office-agent]
# 本文件只是模板；工程的默认值已写在 pyproject.toml，可按需在此覆盖。

# ===== LLM（OpenAI 兼容接口）=====
# 默认 DeepSeek；改 GLM/OpenAI/通义等只需改 base_url + model
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-flash

# 可选：请求超时（秒）、温度
LLM_REQUEST_TIMEOUT=120
LLM_TEMPERATURE=0.5

# ===== OfficeCLI =====
# 留空则自动按优先级查找：bin/officecli[.exe] -> PATH 中的 officecli
OFFICECLI_BIN=
# 单条命令超时（秒）
OFFICECLI_TIMEOUT=120
# Windows 上若启动报 System.Private.Xml / Could not load file or assembly，
# 请先重新 python scripts/fetch_officecli.py，并确认已安装匹配的 .NET Desktop Runtime。

# ===== 输出 =====
# 生成的 docx 落地目录
OUTPUT_DIR=./output

# ===== Agent 行为 =====
# LangGraph 超级步上限（agent↔tools 往返算 2 步）
RECURSION_LIMIT=100

# ===== 会话存储（可选）=====
# memory（默认）或 mysql
SESSION_BACKEND=memory
# 会话 TTL（秒）；0 表示不过期
SESSION_TTL_SECONDS=86400
# 可选，优先于分项配置
MYSQL_DSN=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=office_agent
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=15
MYSQL_WRITE_TIMEOUT=15

# ===== 传输模式（WebSocket / RabbitMQ STOMP）=====
# inproc（默认）或 rabbitmq_stomp
TRANSPORT_MODE=inproc
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=61613
RABBITMQ_LOGIN=guest
RABBITMQ_PASSCODE=guest
RABBITMQ_VHOST=/
STOMP_INBOUND_DESTINATION=/queue/office-agent.inbound
STOMP_OUTBOUND_DESTINATION=/queue/office-agent.outbound
STOMP_DLQ_DESTINATION=/queue/office-agent.dlq
STOMP_EXCHANGE=office-agent
STOMP_ROUTING_KEY=session
STOMP_HEARTBEAT_MS=10000
STOMP_MAX_RETRIES=3
STOMP_RETRY_DELAY_MS=200
# 无 RabbitMQ 时可用内存 broker（单测/本地联调）
# STOMP_USE_MEMORY_BROKER=1

# ===== 日志 =====
# 日志级别: DEBUG/INFO/WARNING/ERROR（默认 INFO）
LOG_LEVEL=INFO

# ===== Web API（可选）=====
# uv run office-agent-api  /  python -m office_agent.api
API_HOST=0.0.0.0
API_PORT=8000
# CORS 允许来源，逗号分隔；* 表示全部
API_CORS_ORIGINS=*
# 开发热重载：API_RELOAD=1
# API_RELOAD=
